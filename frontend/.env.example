# Copy to .env.local for local dev, and set the same names in Vercel.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
VITE_GOOGLE_CLIENT_ID=YOUR-CLIENT-ID.apps.googleusercontent.com
# Optional. Where "Start clipping" goes; leave unset for https://app.clipheist.site.
# For a local backend put this in .env.development.local (used by `npm run dev` only):
# VITE_APP_URL=http://127.0.0.1:8765
